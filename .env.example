# Copiá este archivo a ".env" (en la misma carpeta que server.js) y completá tu clave.
# Conseguila gratis en https://console.anthropic.com/ (sección "API Keys").
ANTHROPIC_API_KEY=

# Opcional: modelo a usar. Si no lo definís, usa claude-sonnet-5 por defecto.
# ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: puerto del servidor (por defecto 3000).
# PORT=3000
